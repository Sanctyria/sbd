NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Use Neon with a rotated credential; never commit the real connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
SESSION_COOKIE_NAME=sanctyria_session
# Set true in production; false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# Optional Sentry backend DSN. Configure in the production secret manager.
SENTRY_DSN=
# Comma-separated user UUIDs allowed to access the global /core admin area.
CORE_ADMIN_USER_IDS=
# Subset of trusted administrator UUIDs allowed to permanently delete accounts.
CORE_SUPER_ADMIN_USER_IDS=
