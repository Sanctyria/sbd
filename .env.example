NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Comma-separated additional exact origins allowed for web CORS and mutations.
WEB_ALLOWED_ORIGINS=https://sanctity.sanctyria.com
# Comma-separated direct proxy addresses allowed to set forwarded client IP headers.
TRUST_PROXY=127.0.0.1,::1
# Use Neon with a rotated credential; never commit the real connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
SESSION_COOKIE_NAME=sanctyria_session
# Set true in production; false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# Optional Resend sender configuration; both values are required to enable email verification and password recovery.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional Firebase Admin service-account JSON; store the real value only in a secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional local/mounted service-account file path for Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Configure all three Cloudinary values to enable mobile media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set the public site key and secret key together; the secret belongs in the backend secret manager.
TURNSTILE_SITE_KEY=0x4AAAAAAF_iokLVf6Mykql3
TURNSTILE_SECRET_KEY=0x4AAAAAAF_iojheeMYGpQd1SAO1JGPWDTM
# Set both Stripe keys to enable checkout and signed webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set all three PayPal values to enable checkout and webhook verification.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# All crypto settings are required together; use a dedicated public donation address.
CRYPTO_WALLET_ADDRESS=
CRYPTO_WALLET_ASSET=
CRYPTO_WALLET_NETWORK=
# Cash App $Cashtag without the leading dollar sign.
CASH_APP_TAG=
# Optional Sentry backend DSN. Configure in the production secret manager.
SENTRY_DSN=
# Optional IndexNow verification key; the matching key file must be served from the web root.
INDEXNOW_KEY=
# Comma-separated user UUIDs allowed to access the global /core admin area.
CORE_ADMIN_USER_IDS=
# Subset of trusted administrator UUIDs allowed to permanently delete accounts.
CORE_SUPER_ADMIN_USER_IDS=
